{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on saturday"],
  "packageRules": [
    {
      "description": "Automerge minor/patch updates",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Never automerge majors",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    {
      "description": "Databases need manual migration planning",
      "matchPackageNames": ["postgres", "redis", "mariadb", "mysql"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
