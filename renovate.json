{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["at any time"],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "automerge": false,
  "packageRules": [
    {
      "description": "Label major updates so they stand out",
      "matchUpdateTypes": ["major"],
      "addLabels": ["major-update"]
    },
    {
      "description": "Databases need manual migration planning",
      "matchPackageNames": [
        "docker.io/library/postgres",
        "docker.io/library/redis",
        "docker.io/library/mariadb"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "LinuxServer.io images: parse version + -lsNNN build revision",
      "matchPackageNames": ["ghcr.io/linuxserver/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)(?:-ls(?<revision>\\d+))?$"
    }
  ]
}
